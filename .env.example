# Environment: local | dev | test | rc | prod
ENVIRONMENT=local

# Product and service names for metrics
PRODUCT_NAME=
SERVICE_NAME=

# Database (APP_DB_* overrides config YAML)
APP_DB_HOST=localhost
APP_DB_PORT=8032
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres
APP_DB_DBNAME=app

# Access middleware
APP_ACCESS_AUTH_URL=http://localhost:8090/auth
APP_ACCESS_VALIDITY_ENDPOINT=http://localhost:8090/api/v1/token_validate
APP_ACCESS_RETRY=3
